rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Public collections — anyone can read, write with valid ID
    match /photographs/{photoId} {
      allow read: if true;
      allow write: if isValidId(photoId);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isValidId(serviceId);
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isValidId(testimonialId);
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isValidId(postId);
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isValidId(faqId);
    }

    // Clients can submit bookings and messages
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if isValidId(bookingId);
    }

    match /messages/{messageId} {
      allow read: if true;
      allow write: if isValidId(messageId);
    }

    // Admin credentials — readable for login, writable only by admin
    match /admin/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-only collections
    match /analytics/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /profile/{docId} {
      allow read: if true;
      allow write: if true; // Allow public write so init can create it
    }

    match /bookingConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /emailConfig/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /seo/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Client accounts — readable for portal login, writable with valid ID
    match /clientAccounts/{clientId} {
      allow read: if true;
      allow write: if isValidId(clientId);
    }

    // Test document for connection validation
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
