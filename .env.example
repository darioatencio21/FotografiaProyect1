# =============================================================================
# VERCEL ENVIRONMENT VARIABLES
# =============================================================================
# Copy these to Vercel Dashboard → Settings → Environment Variables
# Apply to: Production, Preview, and Development
# =============================================================================

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Application URL (set to your Vercel deployment URL in production)
# Example: https://fotografia-project.vercel.app
APP_URL="http://localhost:3000"

# =============================================================================
# LOCAL-ONLY VARIABLES (DO NOT add to Vercel)
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY: Only used in local scripts/ (never exposed in frontend)
# This key has full database access - keep it secret and local only
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =============================================================================
# SUPABASE EDGE FUNCTION SECRETS (configure in Supabase Dashboard)
# =============================================================================
# INSTAGRAM_ACCESS_TOKEN: Initial Instagram Graph API long-lived token
# INSTAGRAM_USER_ID: Instagram Business Account ID (defaults to "me")
# CRON_SECRET: Shared secret to protect sync-instagram endpoint
# RESEND_API_KEY: Resend.com API key for sending emails (set in Dashboard only)
# FROM_EMAIL: Sender email address for Resend (set in Dashboard only)
# =============================================================================
