# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Only used in scripts/ (never exposed in frontend)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# VITE_SEND_EMAIL_SECRET: Shared secret for the send-email Edge Function.
# Generate a random string (e.g. openssl rand -hex 32) and set the same value
# as SEND_EMAIL_SECRET in your Supabase Edge Function environment variables.
VITE_SEND_EMAIL_SECRET="your-secret-here"

# Instagram Sync (Supabase Edge Functions secrets):
# INSTAGRAM_ACCESS_TOKEN: Initial Instagram Graph API long-lived token.
# Set as a secret in Supabase Edge Functions dashboard.
# INSTAGRAM_USER_ID: Instagram Business Account ID (defaults to "me").
# CRON_SECRET: Shared secret to protect the sync-instagram endpoint from unauthorized calls.

# After first run, the token is auto-refreshed and stored in the instagram_config table.
# The edge function falls back to INSTAGRAM_ACCESS_TOKEN env var if the table is empty.
