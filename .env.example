# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Only used in scripts/ (never exposed in frontend)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# VITE_SEND_EMAIL_SECRET: Shared secret for the send-email Edge Function.
# Generate a random string (e.g. openssl rand -hex 32) and set the same value
# as SEND_EMAIL_SECRET in your Supabase Edge Function environment variables.
VITE_SEND_EMAIL_SECRET="your-secret-here"
