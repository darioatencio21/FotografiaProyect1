{
  "entities": {
    "photograph": {
      "title": "Photograph",
      "description": "A curated high-resolution photography item in the gallery.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "exif": {
          "type": "object",
          "properties": {
            "camera": { "type": "string" },
            "lens": { "type": "string" },
            "focalLength": { "type": "string" },
            "aperture": { "type": "string" },
            "shutterSpeed": { "type": "string" },
            "iso": { "type": "string" },
            "location": { "type": "string" }
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "colors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isFavorite": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "resolution": { "type": "string" },
        "size": { "type": "string" }
      },
      "required": ["id", "url", "title", "category"]
    },
    "service": {
      "title": "Service",
      "description": "A photography service or package offered by the studio.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "duration": { "type": "string" },
        "includes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "price": { "type": "number" },
        "slug": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "title", "price"]
    },
    "testimonial": {
      "title": "Testimonial",
      "description": "Client testimonial or feedback.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "comment": { "type": "string" },
        "rating": { "type": "number" },
        "image": { "type": "string" }
      },
      "required": ["id", "name", "comment", "rating"]
    },
    "blogPost": {
      "title": "BlogPost",
      "description": "A blog article written by the studio.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "category": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image": { "type": "string" },
        "date": { "type": "string" },
        "readTime": { "type": "string" },
        "seoKeywords": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] }
      },
      "required": ["id", "title", "content", "status"]
    },
    "faq": {
      "title": "FAQ",
      "description": "A frequently asked question.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "question", "answer"]
    },
    "booking": {
      "title": "Booking",
      "description": "A client photoshoot reservation request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientPhone": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "serviceId": { "type": "string" },
        "peopleCount": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "completed"] },
        "createdAt": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "clientName", "clientEmail", "date", "serviceId", "status"]
    },
    "message": {
      "title": "Message",
      "description": "A direct contact submission message.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "message", "createdAt"]
    },
    "seo": {
      "title": "SEOMetadata",
      "description": "The SEO metadata configurations for the studio.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "ogTitle": { "type": "string" },
        "ogDescription": { "type": "string" },
        "ogImage": { "type": "string" },
        "twitterCard": { "type": "string", "enum": ["summary", "summary_large_image"] },
        "keywords": { "type": "string" },
        "robotsText": { "type": "string" }
      },
      "required": ["title", "description"]
    }
  },
  "firestore": {
    "/photographs/{photoId}": {
      "schema": "photograph",
      "description": "Collection of master photographs showcased in the gallery."
    },
    "/services/{serviceId}": {
      "schema": "service",
      "description": "Collection of photography packages available for booking."
    },
    "/testimonials/{testimonialId}": {
      "schema": "testimonial",
      "description": "Collection of verified client feedback."
    },
    "/blogPosts/{postId}": {
      "schema": "blogPost",
      "description": "Collection of blog articles and essays."
    },
    "/faqs/{faqId}": {
      "schema": "faq",
      "description": "Collection of frequently asked questions."
    },
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Collection of clients photoshoot reservations."
    },
    "/messages/{messageId}": {
      "schema": "message",
      "description": "Collection of contact inquiries."
    },
    "/seo/config": {
      "schema": "seo",
      "description": "Single configuration document containing the site's SEO metadata."
    }
  }
}
